<%
  const sections = cal.homeSections(movies);
  const today = sections.today;
  const weekStart = cal.addDays(today, 1);
  const weekEnd = cal.addDays(today, 7);
  const nextUpcoming = sections.upcoming[0];
  const movieUrl = (movie) => `${basePath}/movie/${movie.slug}/`;
-%>
<%- include('_includes/head', { pageTitle: 'Anime al cinema in Italia' }) %>
<%- include('_includes/site-header', { isHome: true, sections }) %>

<main class="wrap home">

  <section class="section" id="ora" aria-labelledby="ora-title">
    <div class="section__head">
      <h2 class="section__title" id="ora-title"><span class="live-dot" aria-hidden="true"></span>In sala ora</h2>
      <p class="section__context">Oggi, <%= cal.dateWithWeekday(today) %></p>
    </div>

    <% if (sections.now.length) { -%>
    <ul class="grid-2" role="list">
      <% sections.now.forEach(({ movie, info }, index) => { -%>
      <li>
        <a class="card now-card" href="<%= movieUrl(movie) %>">
          <%- include('_includes/poster', { movie, size: 'w500', eager: index < 2 }) %>
          <div class="now-card__body">
            <span class="eyebrow eyebrow--accent">In sala</span>
            <h3 class="now-card__title"><%= movie.title %></h3>
            <div class="now-card__dates">
              <% if (info.end) { -%>
              <p class="now-card__range"><%= cal.rangeShort(info.release, info.end) %></p>
              <p class="now-card__note"><%= info.daysLeft === 0 ? 'Ultimo giorno oggi' : `Ancora ${cal.days(info.daysLeft)} in sala` %></p>
              <% } else { -%>
              <p class="now-card__range">Dal <%= cal.dateLong(info.release) %></p>
              <p class="now-card__note">Fine programmazione non comunicata</p>
              <% } -%>
            </div>
          </div>
        </a>
      </li>
      <% }) -%>
    </ul>
    <% } else { -%>
    <div class="empty-panel">
      <p class="empty-panel__title">Nessun anime in sala in questo momento.</p>
    </div>
    <% } -%>
  </section>

  <section class="section" id="settimana" aria-labelledby="settimana-title">
    <div class="section__head">
      <h2 class="section__title" id="settimana-title">Prossimi 7 giorni</h2>
      <p class="section__context"><%= cal.rangeLong(weekStart, weekEnd) %></p>
    </div>

    <% if (sections.week.length) { -%>
    <ul class="grid-2" role="list">
      <% sections.week.forEach(({ movie, info }) => { -%>
      <li>
        <a class="card week-card" href="<%= movieUrl(movie) %>">
          <span class="date-block" aria-hidden="true">
            <span class="date-block__weekday"><%= cal.weekdayShort(info.release) %></span>
            <span class="date-block__day"><%= cal.dayNumber(info.release) %></span>
            <span class="date-block__month"><%= cal.monthShort(info.release) %></span>
          </span>
          <%- include('_includes/poster', { movie, size: 'w342', eager: false }) %>
          <span class="week-card__body">
            <span class="eyebrow eyebrow--soon">Esce <%= cal.weekdayLong(info.release) %></span>
            <span class="week-card__title"><%= movie.title %></span>
            <span class="week-card__note"><%= info.end ? `Fino al ${cal.dateLong(info.end, false)}` : 'Fine programmazione non comunicata' %></span>
          </span>
        </a>
      </li>
      <% }) -%>
    </ul>
    <% } else { -%>
    <div class="empty-panel">
      <div>
        <p class="empty-panel__title">Nessuna nuova uscita questa settimana.</p>
        <% if (nextUpcoming) { -%>
        <p class="empty-panel__text">La prossima è tra <%= cal.days(nextUpcoming.info.daysUntil) %>.</p>
        <% } -%>
      </div>
      <% if (nextUpcoming) { -%>
      <a class="next-link" href="<%= movieUrl(nextUpcoming.movie) %>">
        <%- include('_includes/poster', { movie: nextUpcoming.movie, size: 'w342', eager: false }) %>
        <span class="next-link__body">
          <span class="next-link__title"><%= nextUpcoming.movie.title %></span>
          <span class="next-link__date">dal <%= cal.dateWithWeekday(nextUpcoming.info.release) %></span>
        </span>
        <%- include('_includes/icon', { name: 'arrow-right' }) %>
      </a>
      <% } -%>
    </div>
    <% } -%>
  </section>

  <section class="section" id="programma" aria-labelledby="programma-title">
    <div class="section__head">
      <h2 class="section__title" id="programma-title">In programma</h2>
      <p class="section__context">Date annunciate da distributori e stampa</p>
    </div>

    <% if (sections.months.length) { -%>
    <% sections.months.forEach((group) => { -%>
    <div class="month">
      <h3 class="month__head">
        <span class="month__name"><%= group.month %></span>
        <span class="month__year"><%= group.year %></span>
      </h3>
      <ul class="month__list" role="list">
        <% group.items.forEach(({ movie, info }) => { -%>
        <li>
          <a class="upcoming-card" href="<%= movieUrl(movie) %>">
            <span class="upcoming-card__day" aria-hidden="true">
              <span class="upcoming-card__weekday"><%= cal.weekdayShort(info.release) %></span>
              <span class="upcoming-card__number"><%= cal.dayNumber(info.release) %></span>
            </span>
            <%- include('_includes/poster', { movie, size: 'w342', eager: false }) %>
            <span class="upcoming-card__body">
              <span class="upcoming-card__title"><%= movie.title %></span>
              <span class="upcoming-card__range"><%= info.end ? cal.rangeLong(info.release, info.end) : `Dal ${cal.dateLong(info.release, false)}` %></span>
              <span class="upcoming-card__meta"><%= cal.inDays(info.daysUntil) %><% if (info.daysInTheater) { %><span class="upcoming-card__length"> · <%= cal.days(info.daysInTheater) %> in sala</span><% } %></span>
            </span>
          </a>
        </li>
        <% }) -%>
      </ul>
    </div>
    <% }) -%>
    <% } else { -%>
    <div class="empty-panel">
      <p class="empty-panel__title">Nessuna uscita annunciata per ora.</p>
    </div>
    <% } -%>
  </section>

</main>

<%- include('_includes/footer') %>
