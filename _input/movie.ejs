---
pagination:
  data: movies
  size: 1
  alias: movie
permalink: "/movie/<%= movie.slug %>/"
---
<%
  const info = cal.describe(movie);
  const badges = {
    now: { label: 'In sala ora', cls: 'badge--now', dot: true },
    week: { label: 'In arrivo', cls: 'badge--week' },
    upcoming: { label: 'In programma', cls: 'badge--upcoming' },
    ended: { label: 'Programmazione terminata', cls: 'badge--ended' },
    tba: { label: 'Data da annunciare', cls: 'badge--upcoming' },
  };
  const badge = badges[info.status];

  const today = {
    now: info.end ? cal.remaining(info.daysLeft) : 'In sala',
    week: cal.inDays(info.daysUntil),
    upcoming: cal.inDays(info.daysUntil),
    ended: 'Terminato',
    tba: 'Da annunciare',
  }[info.status];

  const yearOnlyEnd = /^\d{4}$/.test(movie.theaterEndDate ?? '') ? movie.theaterEndDate : null;
  const from = info.release
    ? { long: cal.dateLong(info.release), short: cal.dateShort(info.release) }
    : { long: info.releaseYear ?? 'Da annunciare', short: info.releaseYear ?? 'Da annunciare' };
  const to = info.end
    ? { long: cal.dateLong(info.end), short: cal.dateShort(info.end) }
    : { long: yearOnlyEnd ?? 'Non comunicato', short: yearOnlyEnd ?? 'Non comunicato' };

  const normalize = (title) => title.trim().toLowerCase();
  const altTitles = [...new Set((movie.alternativeTitles ?? []).map((t) => t.trim()))]
    .filter((t) => t && normalize(t) !== normalize(movie.title));

  const overview = movie.tmdbMovie?.overview?.trim();
  const sources = cal.sourcesByDate(movie.sources);
-%>
<%- include('_includes/head', { pageTitle: `${movie.title} · Anime al cinema` }) %>
<%- include('_includes/site-header', { isHome: false }) %>

<main class="wrap detail">
  <a class="back-link" href="<%= basePath %>/"><%- include('_includes/icon', { name: 'arrow-left' }) %>Tutti i film</a>

  <article class="detail__layout">
    <div class="detail__poster">
      <%- include('_includes/poster', { movie, size: 'w500', eager: true }) %>
    </div>

    <div class="detail__status">
      <span class="badge <%= badge.cls %>"><% if (badge.dot) { %><span class="badge__dot" aria-hidden="true"></span><% } %><%= badge.label %></span>
      <% if (info.status !== 'tba') { -%>
      <p class="detail__today<%= info.status === 'now' ? ' is-accent' : '' %>"><%= today %></p>
      <% } -%>
    </div>

    <div class="detail__heading">
      <h1 class="detail__title"><%= movie.title %></h1>
      <% if (altTitles.length) { -%>
      <p class="detail__alt"><%= altTitles.join(' · ') %></p>
      <% } -%>
    </div>

    <dl class="date-box">
      <div class="date-box__cell">
        <dt>Dal</dt>
        <dd><span class="only-wide"><%= from.long %></span><span class="only-narrow"><%= from.short %></span></dd>
      </div>
      <div class="date-box__cell">
        <dt>Al</dt>
        <dd><span class="only-wide"><%= to.long %></span><span class="only-narrow"><%= to.short %></span></dd>
      </div>
      <div class="date-box__cell date-box__cell--today">
        <dt>Oggi</dt>
        <dd<% if (info.status === 'now') { %> class="is-accent"<% } %>><%= today %></dd>
      </div>
    </dl>

    <% if (overview) { -%>
    <section class="detail__plot" aria-labelledby="trama">
      <h2 class="label" id="trama">Trama</h2>
      <p><%= overview %></p>
    </section>
    <% } -%>

    <% if (sources.length) { -%>
    <section class="sources" aria-labelledby="fonti">
      <div class="sources__head">
        <h2 class="sources__title" id="fonti">Fonti · <%= sources.length %></h2>
        <p class="sources__context">Articoli che confermano le date, dal più recente</p>
      </div>
      <ul class="sources__list" role="list">
        <% sources.forEach((source) => {
          const host = cal.hostname(source.url);
          const published = cal.publishedShort(source.publishedDate);
        -%>
        <li>
          <a class="source" href="<%= source.url %>" target="_blank" rel="noopener">
            <span class="source__date"><%= published %></span>
            <span class="source__meta"><%= [host, published].filter(Boolean).join(' · ') %></span>
            <span class="source__title"><%= source.title || host %></span>
            <span class="source__host"><%= host %></span>
            <%- include('_includes/icon', { name: 'external' }) %>
          </a>
        </li>
        <% }) -%>
      </ul>
    </section>
    <% } -%>
  </article>
</main>

<%- include('_includes/footer') %>
